# 1. CognoDB Cloud
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=
# 2. Neo4j AuraDB Free
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# 3. Memgraph Cloud
MEMGRAPH_URI=bolt+ssc://<host>:<port>
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=
# 4. FalkorDB Cloud
FALKORDB_URI=bolt://<host>:<port>
FALKORDB_USER=falkordb
FALKORDB_PASSWORD=
# 5. ArangoDB (Local Docker — capped: 0.5 vCPU, 256MB RAM)
ARANGO_URI=http://localhost:8529
ARANGO_USER=root
ARANGO_PASSWORD=
ARANGO_DB=_system